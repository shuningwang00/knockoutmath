# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Optional: verified sender on knockoutmath.sg (no extra quotes in Vercel)
# ENQUIRY_FROM_EMAIL=Knockout Math <contact@knockoutmath.sg>
# ENQUIRY_TO=contact@knockoutmath.sg

# Optional: live Google star rating on testimonials + in JSON-LD (Places API)
# Enable "Places API" in Google Cloud, then add:
# GOOGLE_PLACES_API_KEY=your_key
# GOOGLE_PLACE_ID=ChIJ...  (from Google Maps → Share → embed, or Place ID finder)

# Optional: after custom domain DNS points to Vercel, set for OG image URLs:
# OG_IMAGE_ORIGIN=https://www.knockoutmath.sg

# Optional: Google Search Console site verification meta tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Live class schedule + signup dropdowns (same OAuth as kom-billing — no service account)
# CLASSES_SPREADSHEET_ID=13vJjI7fJS41eANI-2iROEXJS4BIIC6kBfoHNY0a258A
# GOOGLE_OAUTH_CLIENT_ID=          (same Cloud Console OAuth client as kom-billing)
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_OAUTH_REFRESH_TOKEN=      (from kom-billing after Connect Google, or /api/auth/google once)
# CLASSES_CACHE_SECONDS=86400
# CLASSES_SHEET_TAB=
# CLASSES_CACHE_FILE=  (optional path for saved snapshot; default data/classes-schedule.snapshot.json)
# Optional if your org allows it: GOOGLE_SERVICE_ACCOUNT_JSON=...
